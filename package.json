{
  "name": "ideal-coaching-centre",
  "version": "1.0.0",
  "private": true,
  "description": "Production Digital Coaching Platform for IDEAL COACHING CENTRE",
  "workspaces": [
    "apps/student-app",
    "apps/whatsapp-service",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "build:packages": "npm run --workspaces --if-present build",
    "dev:student": "npm --workspace=apps/student-app start",
    "dev:whatsapp": "npm --workspace=apps/whatsapp-service run dev"
  },
  "dependencies": {
    "@icc/design-tokens": "*",
    "@icc/shared-types": "*",
    "@icc/shared-utils": "*",
    "@icc/shared-validation": "*",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "edtech",
    "coaching",
    "nextjs",
    "supabase"
  ],
  "author": "IDEAL COACHING CENTRE",
  "license": "UNLICENSED"
}
