{
  "name": "ideal-coaching-centre",
  "version": "1.0.0",
  "private": true,
  "description": "Production Digital Coaching Platform for IDEAL COACHING CENTRE (BSEB & JAC Boards)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run --workspaces --if-present build",
    "build": "npm --workspace=apps/public-website run build",
    "vercel-build": "npm --workspace=apps/public-website run build && rm -rf .next && cp -r apps/public-website/.next .next && (cp -r apps/public-website/public ./ 2>/dev/null || true)",
    "start": "npm --workspace=apps/public-website run start",
    "lint": "npm run --workspaces --if-present lint",
    "test": "npm run --workspaces --if-present test",
    "dev:admin": "npm --workspace=apps/admin-web run dev",
    "dev:public": "npm --workspace=apps/public-website run dev",
    "dev:student": "npm --workspace=apps/student-app start",
    "dev:whatsapp": "npm --workspace=apps/whatsapp-service run dev"
  },
  "keywords": [
    "edtech",
    "bseb",
    "jac",
    "coaching",
    "expo",
    "react-native",
    "nextjs",
    "supabase"
  ],
  "author": "IDEAL COACHING CENTRE",
  "license": "UNLICENSED"
}
