# IDEAL COACHING CENTRE — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local in each app directory

# Supabase Public API Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Expo React Native Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Institution UPI Payment Details (Free Tier)
NEXT_PUBLIC_UPI_ID=idealcoaching@upi
NEXT_PUBLIC_UPI_NAME=IDEAL COACHING CENTRE

# xAI / Grok AI API Configuration
GROK_API_KEY=your-grok-api-key
GROQ_API_KEY=your-groq-api-key
NEXT_PUBLIC_GROK_API_KEY=your-grok-api-key
EXPO_PUBLIC_GROK_API_KEY=your-grok-api-key
